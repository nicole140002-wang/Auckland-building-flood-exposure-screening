# Assumption is that the workspace temp dir has been already set and created.  See controldefs.cpp - ControlDefs::writeVisualizerTempDir
DEFAULT_MACRO WORKSPACE_TEMP_DIR
INCLUDE [    set safeName "[regsub -all {[^a-zA-Z0-9]} {Flood_Plain_Failed} _]_[expr round(rand() * 1000000)]_[clock clicks  -milliseconds]";    puts "MACRO SAFE_FFS_NAME $safeName"; ]
INCLUDE [    if {{NoReduction} == {NoReduction} &&        {NO_THINNING} == {NO_THINNING}} {       puts "MACRO Flood_Plain_Failed_c24818b2_24cd_4f55_862c_193faa6fe4b221_LARGE_GEOMETRY_DATA_STORAGE REFERENCE";    } else {       puts "MACRO Flood_Plain_Failed_c24818b2_24cd_4f55_862c_193faa6fe4b221_LARGE_GEOMETRY_DATA_STORAGE FULL";    }; ]
