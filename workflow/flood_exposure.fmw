FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   INPUT FEATURE_TYPE *    ROUTE GEOJSON GEOJSON_1::Flood_Plains multi_reader_keyword,$(DATASET_KEYWORD_GEOJSON_1) TO FME_GENERIC ::Flood_Plains ALIAS_GEOMETRY    ROUTE GEOJSON GEOJSON_2::walmsley_te_ararata_study_area multi_reader_keyword,$(DATASET_KEYWORD_GEOJSON_2) TO FME_GENERIC ::walmsley_te_ararata_study_area ALIAS_GEOMETRY    ROUTE SHAPEFILE SHAPEFILE_1::nz-building-outlines multi_reader_keyword,$(DATASET_KEYWORD_SHAPEFILE_1) TO FME_GENERIC ::nz-building-outlines ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
GEOJSON_1_MERGE_DEF GEOJSON_1::Flood_Plains EXACT Flood_Plains
GEOJSON_2_MERGE_DEF GEOJSON_2::walmsley_te_ararata_study_area EXACT walmsley_te_ararata_study_area
SHAPEFILE_1_MERGE_DEF SHAPEFILE_1::nz-building-outlines EXACT nz-building-outlines
