GEOJSON_1_DEF Flood_Plains   id                           int   OBJECTID                     int   Hazard                       string   YEAR_PRODUCED                string   Model_Type                   string   RAINFALL_EVENT               int   CLIMATE_CHANGE_ADJUSTED      string   DEVELOPMENT_SCENARIO         string   DOCUMENT_NAME                string   Company                      string   SOFTWARE_USED                string   SOFTWARE_VERSION             string   OTHER_COMMENTS               string   ID                           int   VALIDATIONSTATE              int   GlobalID                     string   PDF_Link                     string   Published_Date               int   Superseded_Date              int   Model_ID                     int   SDEObjectID                  int   Shape__Area                  float   Shape__Length                float
